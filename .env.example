# Quantify Trading System — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.

# ── Alpaca Markets ─────────────────────────────────────────────────────────────
# Paper-trading keys  (from https://app.alpaca.markets/paper-trading/overview)
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Set to "false" to switch to live trading (use with extreme caution)
ALPACA_PAPER=true

# ── Optional overrides ─────────────────────────────────────────────────────────
# Override the default data cache directory
# DATA_CACHE_DIR=data/cache

# Override log level (DEBUG | INFO | WARNING | ERROR)
# LOG_LEVEL=INFO

# ── Telegram Bots ─────────────────────────────────────────────────────────────
# Bot token for automated alerts (e.g. @QuantifyAlertsBot)
# TELEGRAM_BOT_TOKEN=your_alerts_bot_token_here

# Bot token for group prediction query bot (e.g. @QuantifyPredictionBot)
# TELEGRAM_PREDICTION_BOT_TOKEN=your_prediction_bot_token_here

